TOKEN="" # Your bot token, from https://discord.com/developers/applications

CLIENT_ID="" # Your application's Client ID (same page as the token)

PREFIX="!" # Prefix for text commands

OWNER_IDS=["123456789012345678"] # Your Discord user ID(s), for dev-only commands. Can list more than one.

GUILD_ID="" # A server ID to instantly register slash commands to while developing (used only when PRODUCTION=false)

PRODUCTION="true" # true = register slash commands globally (takes up to 1hr to propagate)
                   # false = register instantly, but only to GUILD_ID above

BOT_STATUS="online" # online, idle, dnd, or invisible

BOT_ACTIVITY="24/7 and counting" # The bot's status text

BOT_ACTIVITY_TYPE="2" # 0=Playing 1=Streaming 2=Listening 3=Watching 4=Custom 5=Competing

LOG_CHANNEL_ID="" # Optional: channel ID to post guild join/leave logs to

SUPPORT_SERVER_INVITE="" # Optional: shown as a button on the /invite command

# PORT is set automatically by Render - you don't need to set this yourself.
# It only matters for local testing, where it defaults to 3000.
# PORT=3000
